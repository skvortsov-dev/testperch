{
  "manifest_version": 3,
  "name": "TestPerch",
  "version": "0.0.1",
  "description": "Manage your own experiment and feature flag testing assignments in Amplitude.",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://app.amplitude.com/*",
    "https://app.eu.amplitude.com/*"
  ],
  "action": {
    "default_title": "TestPerch \u2014 Experiment & flag testing for Amplitude",
    "default_popup": "index.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
